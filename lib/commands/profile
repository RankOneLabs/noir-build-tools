#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." 2>/dev/null && pwd)"

LIB_DIR=""
for candidate in \
  "$ROOT_DIR/lib" \
  "$SCRIPT_DIR/../lib" \
  "${NOIR_BUILD_TOOLS_LIB:-}" \
  "$HOME/.local/lib/noir-build-tools" \
  "/usr/local/lib/noir-build-tools"; do
  if [[ -n "$candidate" && -f "$candidate/utils.sh" ]]; then
    LIB_DIR="$candidate"
    break
  fi
done

if [[ -z "$LIB_DIR" ]]; then
  echo "lib/utils.sh not found; set NOIR_BUILD_TOOLS_LIB" >&2
  exit 1
fi

source "$LIB_DIR/utils.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/nargo.sh"
source "$LIB_DIR/format.sh"

usage() {
  cat << EOF
Usage: noir-profile [OPTIONS] [CIRCUIT]

Profile circuit constraints and check budgets.

Options:
  -a, --all      Profile all circuits
  --prove        Generate proof and show proof size (requires Prover.toml)
  --json         Output as JSON
  -h, --help     Show this help

Exit Codes:
  0  All circuits within budget
  1  One or more circuits exceed budget
EOF
}

PROFILE_ALL=false
CIRCUIT_NAME=""
OUTPUT_JSON=false
SHOW_PROOF_SIZE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--all) PROFILE_ALL=true; shift ;;
    --prove) SHOW_PROOF_SIZE=true; shift ;;
    --json) OUTPUT_JSON=true; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "Unknown option: $1" ;;
    *) CIRCUIT_NAME="$1"; shift ;;
  esac
done

load_config

if [[ "$PROFILE_ALL" == "true" ]]; then
  circuits=$(get_circuit_names)
elif [[ -n "$CIRCUIT_NAME" ]]; then
  circuits="$CIRCUIT_NAME"
else
  usage; exit 1
fi

declare -a results=()
over_budget_count=0

for name in $circuits; do
  circuit_path=$(get_circuit_field "$name" "path")
  display_name=$(get_circuit_field "$name" "displayName" "$name")
  budget=$(get_circuit_field "$name" "constraintBudget" "0")

  [[ "$OUTPUT_JSON" != "true" ]] && log_info "Profiling $display_name..."

  nargo_compile "$circuit_path" &>/dev/null || die "Failed to compile $name"

  info=$(nargo_info "$circuit_path")
  acir=$(echo "$info" | jq -r '.acir')
  brillig=$(echo "$info" | jq -r '.brillig')
  total=$((acir + brillig))

  # Generate proof and get size if --prove flag is set
  proof_size=0
  if [[ "$SHOW_PROOF_SIZE" == "true" ]]; then
    if [[ -f "$circuit_path/Prover.toml" ]]; then
      
      backend_path=$(get_backend_path)
      if ! command -v "$backend_path" &>/dev/null; then
        log_warn "Backend '$backend_path' not found. Cannot generate proof."
      else
        # Execute to generate witness
        nargo execute --package "$name" &>/dev/null 2>&1 || true
        
        # Generate proof (disable job control to suppress crash messages)
        set +m
        proof_out="$circuit_path/target/proof"
        
        # Run prove command and capture status
        if ! "$backend_path" prove -b "$circuit_path/target/${name}.json" \
                 -w "$circuit_path/target/${name}.gz" \
                 -o "$proof_out" &>/dev/null; then
            log_warn "Proof generation failed for $name"
        fi
        
        set -m 2>/dev/null || true
        
        if [[ -f "$proof_out" ]]; then
          # portable file size check (stat is non-portable between GNU/BSD)
          proof_size=$(wc -c < "$proof_out" 2>/dev/null | tr -d '[:space:]' || echo "0")
        fi
      fi
    fi
  fi

  within_budget="true"
  if [[ "$budget" -gt 0 ]] && [[ "$total" -gt "$budget" ]]; then
    within_budget="false"
    ((over_budget_count++))
  fi

  results+=("{\"name\":\"$name\",\"acir\":$acir,\"brillig\":$brillig,\"total\":$total,\"budget\":$budget,\"proofSize\":$proof_size,\"withinBudget\":$within_budget}")
done

if [[ "$OUTPUT_JSON" == "true" ]]; then
  echo "["
  for i in "${!results[@]}"; do
    [[ $i -gt 0 ]] && echo ","
    echo "  ${results[$i]}"
  done
  echo "]"
else
  echo ""
  if [[ "$SHOW_PROOF_SIZE" == "true" ]]; then
    print_profile_header_with_proof
  else
    print_profile_header
  fi

  for result in "${results[@]}"; do
    name=$(echo "$result" | jq -r '.name')
    acir=$(echo "$result" | jq -r '.acir')
    brillig=$(echo "$result" | jq -r '.brillig')
    total=$(echo "$result" | jq -r '.total')
    proof_size=$(echo "$result" | jq -r '.proofSize')
    within=$(echo "$result" | jq -r '.withinBudget')
    status=$(format_status "$within")

    if [[ "$SHOW_PROOF_SIZE" == "true" ]]; then
      printf "| %-20s | %12s | %12s | %12s | %12s | %10s |\n" \
        "$name" "$(format_number "$acir")" "$(format_number "$brillig")" "$(format_number "$total")" "$(format_bytes "$proof_size")" "$status"
    else
      printf "| %-20s | %12s | %12s | %12s | %10s |\n" \
        "$name" "$(format_number "$acir")" "$(format_number "$brillig")" "$(format_number "$total")" "$status"
    fi
  done

  if [[ "$SHOW_PROOF_SIZE" == "true" ]]; then
    print_separator_with_proof
  else
    print_separator
  fi
  echo ""

  if [[ $over_budget_count -gt 0 ]]; then
    log_error "$over_budget_count circuit(s) exceeded constraint budget"
  else
    log_success "All circuits within budget"
  fi
fi

[[ $over_budget_count -eq 0 ]]
